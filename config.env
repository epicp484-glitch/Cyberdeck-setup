# =============================================================================
#  Cyberdeck configuration — every setting lives here.
#
#  This file is plain bash: KEY="value", no spaces around "=".
#  You can reference earlier values, e.g. ZIM_DIR="${DATA_DIR}/zim".
#
#  Want personal changes without editing this file? Create config.local.env
#  next to it (it is git-ignored) and put only the lines you want to change.
#  After changing anything, run ./install.sh again to apply it.
# =============================================================================

# -----------------------------------------------------------------------------
# General
# -----------------------------------------------------------------------------
# Desktop user that gets the launchers / AI mode. Empty = the user running install.sh.
CYBERDECK_USER=""

# Where the cyberdeck scripts, tools and data are installed.
INSTALL_DIR="/opt/cyberdeck"
DATA_DIR="${INSTALL_DIR}/data"

# Run "apt-get upgrade" during install (true/false).
SYSTEM_UPGRADE="true"

# Where Docker comes from: "official" (download.docker.com, newest)
# or "ubuntu" (docker.io + docker-compose-v2 from the Ubuntu archive).
DOCKER_SOURCE="official"

# -----------------------------------------------------------------------------
# Ollama (runs the AI model)
# -----------------------------------------------------------------------------
# The model to download and use. Browse others at https://ollama.com/library
# Good alternatives for 12 GB RAM: qwen3.5:2b (faster), qwen3.5:0.8b (fastest),
# qwen3.5:9b (smarter but slow on an N95).
OLLAMA_MODEL="qwen3.5:4b"

# Optional: path to a local .gguf file to import as OLLAMA_MODEL instead of
# downloading it (useful for installing from a USB stick). Leave empty normally.
OLLAMA_MODEL_FILE=""

OLLAMA_BIND="127.0.0.1"
OLLAMA_PORT="11434"
# Context window in tokens. 8192 fits easily in 12 GB with a 4B model.
OLLAMA_CONTEXT_LENGTH="8192"
# How long the model stays in RAM after the last question (normal desktop mode).
OLLAMA_KEEP_ALIVE="10m"
# Keep these at 1 on a small machine: one model, one request at a time.
OLLAMA_NUM_PARALLEL="1"
OLLAMA_MAX_LOADED_MODELS="1"
# Official installer script.
OLLAMA_INSTALL_URL="https://ollama.com/install.sh"

# -----------------------------------------------------------------------------
# Open WebUI (chat interface, runs in Docker)
# -----------------------------------------------------------------------------
OPEN_WEBUI_IMAGE="openwebui/open-webui:latest"
OPEN_WEBUI_PORT="3000"
# 127.0.0.1 = only this computer can open it. Use 0.0.0.0 to allow your
# phone/laptop on the same network (no password is set — be careful).
OPEN_WEBUI_BIND="127.0.0.1"
OPEN_WEBUI_DATA_DIR="${DATA_DIR}/open-webui"
# A ready-made chat model with the Wikipedia tool switched on.
OPEN_WEBUI_MODEL_ID="cyberdeck-ai"
OPEN_WEBUI_MODEL_NAME="Cyberdeck AI (Wikipedia)"

# -----------------------------------------------------------------------------
# Kiwix (offline Wikipedia)
# -----------------------------------------------------------------------------
KIWIX_BIND="127.0.0.1"
KIWIX_PORT="8090"

# The Wikipedia file to download. Sizes (2026):
#   wikipedia_en_all_mini_*   ~12 GB  intro + infobox of every article (default)
#   wikipedia_en_all_nopic_*  ~50 GB  full text, no pictures
#   wikipedia_en_all_maxi_*  ~110 GB  everything, with pictures
#   wikipedia_en_100_*         ~5 MB  only 100 articles (good for testing)
# Full list: https://download.kiwix.org/zim/wikipedia/
ZIM_URL="https://download.kiwix.org/zim/wikipedia/wikipedia_en_all_mini_2026-06.zim"
# If ZIM_URL is gone (Kiwix deletes old dated files), find the newest file with
# the same name prefix on the same server instead.
ZIM_AUTO_LATEST="true"
ZIM_DIR="${DATA_DIR}/zim"
# Already have a .zim file? Put its full path here and nothing is downloaded.
ZIM_PATH=""

# -----------------------------------------------------------------------------
# Offline Wikipedia tool (Open WebUI tool + wiki-ask command)
# -----------------------------------------------------------------------------
# Which Kiwix book to search. Empty = first book whose name starts with "wikipedia".
KIWIX_BOOK=""
# Max characters of article text handed to the model (~4 characters per token).
WIKI_MAX_CHARS="6000"
# How many articles to pull into one answer (1 is best for small models).
WIKI_MAX_ARTICLES="1"

# -----------------------------------------------------------------------------
# AI mode (kiosk)
# -----------------------------------------------------------------------------
# What to do with other open windows: close (polite close, like clicking X),
# minimize, or none.
AI_MODE_WINDOWS="close"

# Browser for the kiosk: auto (tries webkit, then chromium, then firefox),
# webkit (tiny built-in window, lightest), chromium, firefox.
AI_MODE_BROWSER="auto"
# Page zoom for the 7-inch screen (1.0 = 100%).
AI_MODE_ZOOM="1.0"
# Closing the kiosk window also exits AI mode (true/false).
AI_MODE_EXIT_ON_CLOSE="true"
# Keep the model loaded in RAM the whole time AI mode is on.
AI_MODE_KEEP_ALIVE="-1"
# Unload the model when leaving AI mode to give the RAM back.
AI_MODE_UNLOAD_ON_EXIT="true"
# Stop the screen from blanking while in AI mode.
AI_MODE_NO_SCREEN_BLANK="true"

# Desktop settings switched off in AI mode, as "schema key value".
# Keys that don't exist on your Cinnamon version are skipped automatically.
# The original values are saved and put back by "Exit AI Mode".
AI_MODE_GSETTINGS=(
  "org.cinnamon desktop-effects-workspace false"
  "org.cinnamon desktop-effects-on-menus false"
  "org.cinnamon desktop-effects-on-dialogs false"
  "org.cinnamon enable-vfade false"
  "org.cinnamon startup-animation false"
  "org.cinnamon.desktop.interface enable-animations false"
  "org.cinnamon.muffin desktop-effects false"
)

# Background apps closed in AI mode and restarted afterwards.
# Format: "process pattern|command to restart it"
AI_MODE_STOP_APPS=(
  "nemo-desktop|nemo-desktop"
  "mintUpdate|mintupdate-launcher"
  "mintreport-tray|mintreport-tray"
  "warpinator|warpinator --autostart"
  "onboard|"
)

# System services stopped in AI mode and started again afterwards.
# Bluetooth is left alone on purpose (your keyboard might use it).
AI_MODE_STOP_SERVICES=(
  "cups.service"
  "cups-browsed.service"
  "ModemManager.service"
  "kerneloops.service"
  "colord.service"
  "fwupd.service"
  "packagekit.service"
  "apt-daily.timer"
  "apt-daily-upgrade.timer"
  "fstrim.timer"
  "man-db.timer"
)
